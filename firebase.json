{
  "hosting": [
    {
      "target": "yline",
      "public": "public_yline",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "/studio/**",
          "destination": "/studio.html"
        },
        {
          "source": "/studio",
          "destination": "/studio.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "yline-studio",
      "public": "public_studio",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
